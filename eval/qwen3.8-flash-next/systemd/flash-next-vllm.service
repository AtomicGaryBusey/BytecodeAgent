[Unit]
# Qwen3.8-Flash-Next (nvidia NVFP4) served across both DGX Sparks, TP=2 + EP + MTP x2.
# Spark 1 side: Ray head + vLLM API server on $API_BIND:8110 (LiteLLM routes
# `gym-eval` and `Qwen3.8-Flash-Next`). Worker: flash-next-ray-worker.service on Spark 2.
# Config lives in the run script's defaults (SPEC=1 SPEC_TOKENS=2 GPU_UTIL=0.50
# MAX_SEQS=16) -- do NOT set Environment= here, or the script defaults are overridden.
Description=Qwen3.8-Flash-Next vLLM API server (TP=2 across both Sparks)
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target
# Unlimited retries: at boot the QSFP address (NVIDIA Sync) and the Spark 2 worker
# can lag by many minutes; each preflight failure exits 1 and retries after 60s.
StartLimitIntervalSec=0
# Never run alongside the parked Qwen3.8-27B head -- both claim Ray port 6379.
Conflicts=qwen38-vllm.service

[Service]
Type=simple
User=flashnext
Group=flashnext
ExecStart=/opt/flash-next/flash-next-vllm-run.sh
ExecStop=/usr/bin/docker stop -t 30 flash-next-vllm
ExecStopPost=-/usr/bin/docker rm -f flash-next-vllm
Restart=on-failure
RestartSec=60
TimeoutStopSec=120
StandardOutput=append:/opt/flash-next/logs/flash-next-vllm.log
StandardError=append:/opt/flash-next/logs/flash-next-vllm.log

[Install]
WantedBy=multi-user.target
