[Unit]
# Spark 2 half of Qwen3.8-Flash-Next TP=2 (Ray worker). Head: flash-next-vllm.service on Spark 1.
# Restart=always: it may start before the head exists, or lose the head when vLLM
# restarts; it keeps retrying until it joins.
Description=Qwen3.8-Flash-Next Ray worker (Spark 2 half of TP=2)
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target
StartLimitIntervalSec=0
Conflicts=qwen38-ray-worker.service

[Service]
Type=simple
User=flashnext
Group=flashnext
ExecStart=/opt/flash-next/flash-next-ray-worker-run.sh
ExecStop=/usr/bin/docker stop -t 20 flash-next-ray-worker
ExecStopPost=-/usr/bin/docker rm -f flash-next-ray-worker
Restart=always
RestartSec=15
TimeoutStopSec=90
StandardOutput=append:/opt/flash-next/logs/flash-next-ray-worker.log
StandardError=append:/opt/flash-next/logs/flash-next-ray-worker.log

[Install]
WantedBy=multi-user.target
