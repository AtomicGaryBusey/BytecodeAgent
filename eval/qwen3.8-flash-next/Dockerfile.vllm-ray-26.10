# vLLM + Ray for multi-node TP=2 on the DGX Sparks -- 26.10 base, for Qwen3.8-Flash-Next.
#
# WHY A NEW FILE: nvcr.io/nvidia/vllm:26.07-py3 (vLLM 0.24.0) has no Qwen4Exp
# architecture. 26.10 ships vLLM 0.31.0+88641915.nv26.10 with Qwen4ExpForCausalLM,
# Qwen4ExpForConditionalGeneration and Qwen4ExpMTP (verified 2026-11-16).
# Dockerfile.vllm-ray (26.07) is kept unchanged for Qwen3.8-27B.
#
# Ray: still stripped from the NVIDIA image -> same pinned install as before.
# xgrammar: the 26.07 override is NOT needed here -- 26.10 ships xgrammar 0.2.7,
# which has normalize_tool_choice, and the tool-parser import succeeds (verified
# 2026-11-16). The assert below keeps that guarantee checked on every build.
#
# BUILD ON BOTH NODES from this file:
#   docker build -f Dockerfile.vllm-ray-26.10 -t vllm-ray:26.10 .
FROM nvcr.io/nvidia/vllm:26.10-py3

ARG RAY_VERSION=2.57.0
RUN pip install --no-cache-dir "ray[default]==${RAY_VERSION}" \
 && ray --version \
 && python3 -c "import ray; print('ray import OK', ray.__version__)" \
 && python3 -c "import xgrammar; assert hasattr(xgrammar,'normalize_tool_choice'); print('xgrammar tool-choice symbol OK')" \
 && python3 -c "from vllm.model_executor.models.registry import ModelRegistry as R; assert 'Qwen4ExpForConditionalGeneration' in R.get_supported_archs(); print('Qwen4Exp arch OK')"

LABEL org.flashnext.base="nvcr.io/nvidia/vllm:26.10-py3" \
      org.flashnext.vllm="0.31.0+88641915.nv26.10" \
      org.flashnext.ray="2.57.0" \
      org.flashnext.purpose="multi-node TP=2 for Qwen3.8-Flash-Next"
