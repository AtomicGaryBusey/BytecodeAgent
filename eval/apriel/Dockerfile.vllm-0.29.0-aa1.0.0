# The image Apriel was served from: bca-vllm-kolibri:0.29.0-aa1.0.0 (local image id sha256:79ae3f7ef089...).
# Reconstructed 2026-11-16 from `docker history` of that image: the official vLLM 0.29.0 OpenAI-server image
# (label org.opencontainers.image.revision 98dff2a81d747d1dba01a47f939f48c3526d4206) plus Aleph Alpha's plugin,
# installed for Kolibri-1. The plugin does not touch Apriel (a LLaVA-style checkpoint: a Mistral text model with a Pixtral vision tower, used text-only here).
# Build: docker build -f eval/apriel/Dockerfile.vllm-0.29.0-aa1.0.0 -t bca-vllm-kolibri:0.29.0-aa1.0.0 .
FROM vllm/vllm-openai:v0.29.0
RUN pip install --no-deps 'aleph-alpha-inference==1.0.0'
ENTRYPOINT ["vllm", "serve"]
