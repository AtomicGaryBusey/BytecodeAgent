.venv/
__pycache__/
*.so
.pytest_cache/
build/
.codegraph/
*.blend1
# live-eval run locks
eval/runs/**/*.lock
# Side art (2D/3D) is kept outside all repos (~/Art); never commit it here
art/

# local Claude Code settings and agent worktrees
.claude/

# local follow-up notes (not for the repo)
followups/

# Raw vendor streams (the per-event audit record of each call) stay on the machine that ran the eval, gzipped
# (`*.raw.jsonl.gz`, read with zcat); they were removed from git history on 2026-11-11 (95% of the repo).
# Responses, prompts and verdicts stay tracked.
eval/runs/**/*.raw.jsonl
eval/runs/**/*.raw.jsonl.gz
eval/runs/**/*.raw.jsonl.gz.tmp
